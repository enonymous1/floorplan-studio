{"description":"Browser-based floor plan editor. Exports the shared plan format rendered by the Python renderer.","devDependencies":{"autoprefixer":"10.6.2","postcss":"8.4.49","tailwindcss":"3.4.17"},"name":"floorplan-editor","scripts":{"build:css":"tailwindcss -i ./src/tailwind.css -o ./dist/styles.css --minify","check":"node --experimental-vm-modules scripts/check-syntax.mjs","serve":"python3 -m http.server 8000","test":"node --test tests/plan.test.mjs","watch:css":"tailwindcss -i ./src/tailwind.css -o ./dist/styles.css --watch"},"type":"module","version":"2.2.5"}